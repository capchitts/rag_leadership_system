# =========================
# RAG Leadership System
# Environment Variables
# =========================

# -------------------------
# Active LLM Provider
# Options:
#   groq
#   google
#   huggingface
# -------------------------
LLM_PROVIDER=groq

# =========================
# GROQ
# =========================
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile


# =========================
# GOOGLE GEMINI
# =========================
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash


# =========================
# HUGGINGFACE INFERENCE API
# =========================
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.3


# =========================
# EMBEDDING SETTINGS
# =========================
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32


# =========================
# RETRIEVAL SETTINGS
# =========================
TOP_K_RETRIEVAL=8
TOP_K_RERANK=5
BM25_WEIGHT=0.4
VECTOR_WEIGHT=0.6


# =========================
# CHUNKING SETTINGS
# =========================
CHUNK_SIZE=800
CHUNK_OVERLAP=120
PARENT_CHUNK_SIZE=1500
CHILD_CHUNK_SIZE=500


# =========================
# RERANKING
# =========================
ENABLE_RERANKING=true
RERANKER_MODEL=BAAI/bge-reranker-large


# =========================
# PDF / TABLE EXTRACTION
# =========================
ENABLE_TABLE_EXTRACTION=true
ENABLE_IMAGE_EXTRACTION=false


# =========================
# EVALUATION
# =========================
ENABLE_EVALUATION=true
FAITHFULNESS_LLM_PROVIDER=groq
GROUNDEDNESS_LLM_PROVIDER=groq


# =========================
# APP SETTINGS
# =========================

LOG_LEVEL=INFO
DATA_DIR=data/reports

# =========================
# MongoDB And FAISS
# =========================

FAISS_INDEX_PATH=artifacts/faiss.index
FAISS_STORE_PATH=artifacts/faiss_store.pkl
BM25_INDEX_PATH=artifacts/bm25_index.pkl

MONGODB_URI = mongodb://localhost:27017
MONGODB_DB_NAME = rag_leadership_system